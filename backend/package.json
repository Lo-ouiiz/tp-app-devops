{
  "name": "gym-management-backend",
  "version": "1.0.0",
  "description": "Backend for gym management system",
  "main": "src/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node seed/seed.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:push": "npx prisma db push",
    "db:setup": "npx prisma generate && npx prisma migrate deploy",
    "lint": "eslint .",
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --outdir=dist",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.6.0",
    "ts-jest": "^29.4.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
